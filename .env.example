# Copy to .env and fill in. Never commit the real .env file.

# SQLite file path (relative to repo root)
DATABASE_URL=sqlite:///./niche_scout.db

# Autocomplete provider is free and needs no key, but is rate-limited.
AUTOCOMPLETE_RATE_LIMIT_PER_SEC=1

# Paid keyword-metrics provider (search volume, competition score).
# See docs/data-sources.md for which provider this is and how to swap it.
METRICS_API_KEY=
METRICS_API_BASE_URL=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
